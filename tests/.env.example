# Copy this file to .env and fill in real values for the server you're
# targeting. .env is never committed (see .gitignore); this example file is.
#
# If you used `bash scripts/run-server.sh` (or `make e2e-server`) to start a
# disposable instance, it writes a ready-to-use tests/.env for you
# automatically — you don't need to edit this by hand in that case.

# Wherever your OIDC-enabled server is already running.
E2E_BASE_URL=http://127.0.0.1:8099

# Must belong to a real active administrator on that server.
E2E_ADMIN_EMAIL=e2e-admin@example.test
E2E_ADMIN_PASSWORD=e2e admin password not a real secret
